POSTGRES_DB=coachbooking
POSTGRES_USER=coachbooking
POSTGRES_PASSWORD=coachbooking
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMIN_PORT=3001
# Generate a unique secret (at least 32 random bytes); no built-in fallback.
JWT_SECRET=
# Local HTTP only. Set true behind HTTPS in production.
APP_AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:8080

# Cấu hình SMTP cho tính năng Quên mật khẩu (OTP qua email)
APP_MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
APP_MAIL_FROM=no-reply@coachbooking.local
APP_MAIL_FROM_NAME=CoachBooking

# Swagger / OpenAPI UI (tắt bằng false trên môi trường production)
APP_SWAGGER_ENABLED=true

# Google OAuth2 Login (khách hàng)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback

# SonarQube / SonarCloud — dùng cho sonar-scanner chạy cục bộ.
# CI trên GitHub đọc SONAR_TOKEN từ Secrets và SONAR_HOST_URL từ Variables,
# không đọc file .env này.
SONAR_HOST_URL=https://sonarcloud.io
SONAR_PROJECT_KEY=phamleanhkhoa101_CoachBooking
SONAR_ORGANIZATION=phamleanhkhoa101
SONAR_TOKEN=

# SePay Payment Gateway: sandbox only. Never use VITE_* for these secrets.
SEPAY_ENABLED=false
SEPAY_ENVIRONMENT=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Independent random secret; configure Auth Type SECRET_KEY in SePay IPN settings.
SEPAY_IPN_SECRET=
# Public HTTPS origin of the customer frontend, including the /api reverse proxy.
SEPAY_FRONTEND_URL=
# Default for deployed environments; keep IPN unless testing the local polling flow.
SEPAY_CONFIRMATION_MODE=IPN
SEPAY_LOCAL_RETURN_URL=http://localhost:3000
# POLLING requires profile local; deploy environments should keep default/prod.
SPRING_PROFILES_ACTIVE=default
